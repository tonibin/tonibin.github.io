\par }\pard\plain \ltrpar\s21\qj \li0\ri0\widctlpar\wrapdefault\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid14638961 \rtlch\fcs1 \af0\afs22\alang1025 \ltrch\fcs0 \f37\fs22\cf17\lang1040\langfe1040\cgrid\langnp1040\langfenp1040 {\rtlch\fcs1 \af0 
