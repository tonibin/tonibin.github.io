\pard\ri1\ql\tx1\tqr\tldot\tx5775\fi0\sl-235\f00 \fs21{\tab\fs21\charscalex106\b0\i0\ul0\f00 sasso \fs27\charscalex172\i\f10 I \fs21\charscalex106\i0\f00 Che distingua le \fs20\charscalex112\i mie \fs21\charscalex106\i0 dalle infinite / Ossa \tab "); \par}
